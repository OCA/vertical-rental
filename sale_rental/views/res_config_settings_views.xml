<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_sale_rental" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.stock.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='connectors_setting_container']" position="after">
                <block title="Sale Rental" id="sale_rental_setting_container">
                    <setting
                        id="send_return_reminder_setting"
                        help="Send an email reminder to customers before their rental is due for return."
                    >
                        <field name="send_return_reminder" />
                        <div class="content-group" invisible="not send_return_reminder">
                            <div class="row mt16">
                                <label
                                    for="reminder_days"
                                    class="col-md-6 o_light_label"
                                />
                                <field name="reminder_days" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
